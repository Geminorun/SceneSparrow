          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "WorkItemPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkItemView"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "WorkChangePage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkChangeView"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "ProductionFileLockPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductionFileLockView"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "GraphRecoveryPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphRecoveryView"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "GraphRecoveryMemberPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphRecoveryMemberView"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["records", "continuation"]
    },
    "WorkNarrationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "sourceBlockId",
        "sourceRevision",
        "currentRevision",
        "status",
        "adapted"
      ],
      "properties": {
        "segmentId": {
          "type": "string"
        },
        "sourceBlockId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0
        },
        "currentRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": ["available", "diverged", "missing"]
        },
        "adapted": {
          "type": "boolean"
        }
      }
    },
    "GraphRecoveryInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentHash", "observationFingerprint"],
      "properties": {
        "intentHash": {
