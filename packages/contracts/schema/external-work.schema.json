              "$ref": "#/definitions/WorkItemView"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuthoredSourceSaveResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["operation", "item", "result"]
    },
    "WorkChangeView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memberId": {
          "type": "string"
