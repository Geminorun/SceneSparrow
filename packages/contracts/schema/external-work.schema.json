        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["add", "delete", "replace"]
        },
        "beforeHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "beforeSize": {
          "type": "integer",
          "minimum": 0
