        "afterSize": {
          "type": "integer",
          "minimum": 0
        },
        "renameHint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "memberId",
        "path",
        "kind",
        "beforeHash",
        "afterHash",
        "beforeSize",
        "afterSize",
        "renameHint",
        "text",
        "truncated"
      ]
    },
    "ProductionFileLockView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": ["path", "hash"]
    },
    "GraphRecoveryView": {
      "type": "object",
