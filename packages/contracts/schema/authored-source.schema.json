{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Named authored source capabilities",
  "definitions": {
    "AuthoredSourceSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "projectId",
        "expectedWorkingRevision",
        "expectedGeneration",
        "expectedHash",
        "source",
        "group"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "expectedWorkingRevision": {
          "type": "integer",
          "minimum": 0
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "expectedHash": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "group": {
          "$ref": "#/definitions/EditGroup"
        }
      }
    },
    "AuthoredSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "kind",
        "startUtf8",
        "endUtf8",
        "listItemAddress",
        "id",
        "semanticEditable"
      ],
      "properties": {
        "address": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "startUtf8": {
          "type": "integer",
          "minimum": 0
        },
        "endUtf8": {
          "type": "integer",
          "minimum": 0
        },
        "listItemAddress": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "semanticEditable": {
          "type": "boolean"
        }
      }
    },
    "AuthoredSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "workingRevision",
        "generation",
        "acceptedHash",
        "source",
        "bindings",
        "semanticBlockIds",
        "externalStatus",
        "externalHash"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "workingRevision": {
          "type": "integer",
          "minimum": 0
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedHash": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoredSourceBinding"
          }
        },
        "semanticBlockIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalStatus": {
          "type": "string",
          "enum": ["unchanged", "changed", "missing", "unavailable"]
        },
        "externalHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AuthoredSourceSaveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "snapshot"],
      "properties": {
        "receipt": {
          "$ref": "#/definitions/CommandReceipt"
        },
        "snapshot": {
          "$ref": "#/definitions/AuthoredSourceSnapshot"
        }
      }
    },
    "ProjectFormatInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "formatVersion", "projectId"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "legacy",
            "unmanaged",
            "managed",
            "futureReadOnly",
            "recoveryRequired"
          ]
        },
        "formatVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AuthoredSourceResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "projectId",
        "expectedWorkingRevision",
        "expectedGeneration",
        "expectedHash",
        "group",
        "candidateId",
        "candidateHash",
        "disposition",
        "source"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "expectedWorkingRevision": {
          "type": "integer",
          "minimum": 0
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "expectedHash": {
          "type": "string"
        },
        "group": {
          "$ref": "#/definitions/EditGroup"
        },
        "candidateId": {
          "type": "string"
        },
        "candidateHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": ["accept", "discard", "proposal"]
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AuthoredSourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "baseHash",
        "baseGeneration",
        "liveHash",
        "source",
        "bindings",
        "validationError",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "baseHash": {
          "type": "string"
        },
        "baseGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "liveHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoredSourceBinding"
          }
        },
        "validationError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": ["pending", "accept", "discard", "proposal"]
        }
      }
    },
    "AuthoredSourcePendingIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentHash", "requestId", "version"],
      "properties": {
        "intentHash": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AuthoredSourceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "generation",
        "acceptedHash",
        "externalStatus",
        "externalHash",
        "candidateId",
        "pendingIntent",
        "watchMode",
        "observationFingerprint"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedHash": {
          "type": "string"
        },
        "externalStatus": {
          "type": "string",
          "enum": [
            "unchanged",
            "changed",
            "missing",
            "unavailable",
            "unstable",
            "invalid"
          ]
        },
        "externalHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pendingIntent": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuthoredSourcePendingIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "watchMode": {
          "type": "string",
          "enum": ["native", "polling", "stopped"]
        },
        "observationFingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AuthoredSourceRecoverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "intentHash", "requestId"],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "intentHash": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": ["known", "preserveExternal"]
        },
        "observationFingerprint": {
          "type": "string"
        }
      }
    },
    "AuthoredSourceRescanRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AuthoredSourceRecoveryVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHash", "roles", "size", "utf8"],
      "properties": {
        "sourceHash": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "utf8": {
          "type": "boolean"
        }
      }
    },
    "AuthoredSourceRecoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "intentHash", "versions"],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "intentHash": {
          "type": "string"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoredSourceRecoveryVersion"
          }
        }
      }
    },
    "AuthoredSourceRecoveryBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "intentHash",
        "sourceHash",
        "bytesBase64",
        "source"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "intentHash": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        },
        "bytesBase64": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
