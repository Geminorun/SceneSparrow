{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "health",
    "createProject",
    "projectResponse",
    "apiError"
  ],
  "properties": {
    "project": {
      "$ref": "#/definitions/Project"
    },
    "health": {
      "$ref": "#/definitions/Health"
    },
    "createProject": {
      "$ref": "#/definitions/CreateProject"
    },
    "projectResponse": {
      "$ref": "#/definitions/ProjectResponse"
    },
    "apiError": {
      "$ref": "#/definitions/ApiError"
    }
  },
  "definitions": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "workingRevision", "approvedBaseline"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "workingRevision": {
          "type": "integer",
          "minimum": 0
        },
        "approvedBaseline": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocolVersion"],
      "properties": {
        "status": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        }
      }
    },
    "CreateProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "title"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "ProjectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": {
        "project": {
          "anyOf": [
            {
              "$ref": "#/definitions/Project"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string"
        }
      }
    }
  }
}
