{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project transfer operations",
  "definitions": {
    "LegacyMigrationInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "legacySchema",
        "workingRevision",
        "historyRevision",
        "cursor",
        "historyCount",
        "blockCount",
        "retainedObjectCount",
        "contentBase",
        "supported"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "legacySchema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workingRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historyRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedObjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contentBase": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "supported": {
          "type": "boolean"
        }
      }
    },
    "MigrationTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "projectId", "destination"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "destination": {
          "type": "string",
          "enum": ["managed"]
        }
      }
    },
    "MigrationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "projectId", "destination"],
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "destination": {
          "type": "string",
          "enum": ["managed"]
        }
      }
    },
    "LegacyMigrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "projectId", "contentBase", "targetId"],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "contentBase": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "targetId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        }
      }
    },
    "MigrationOperationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "projectId",
        "targetId",
        "contentBase",
        "operationRevision",
        "phase",
        "state",
        "completedBytes",
        "completedObjects",
        "normalizedOrigin"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "targetId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "contentBase": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "operationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "type": "string",
          "enum": [
            "queued",
            "backup",
            "upgrade",
            "serialize",
            "verify",
            "promote",
            "ready"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "completedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completedObjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failureCode": {
          "type": "string",
          "maxLength": 80
        },
        "backupId": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "resultId": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "normalizedOrigin": {
          "type": "boolean"
        },
        "lastControlId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        }
      }
    },
    "MigrationStartResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "operation"],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "operation": {
          "$ref": "#/definitions/MigrationOperationView"
        }
      }
    },
    "MigrationControlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "projectId",
        "operationId",
        "expectedOperationRevision",
        "action"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "projectId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "operationId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "expectedOperationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": ["cancel", "retry"]
        }
      }
    }
  }
}
