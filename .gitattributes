# Use consistent text files on Windows, macOS, and Linux.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve documents, media, and database fixtures byte for byte.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.flac binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.sqlite binary
*.sqlite3 binary
*.db binary
